# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/waggora"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── Auth & Secrets ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="changeme-generate-a-32-char-min-secret-here"
MULTIPLIER_SECRET="changeme-generate-another-32-char-secret"
ADMIN_SECRET="changeme-admin-secret"

# ─── Optional ─────────────────────────────────────────────────
CORS_ORIGINS="*"
WELCOME_BONUS_TOKENS=100
